# Local Docker database settings. Copy this file to .env and choose a private password.
POSTGRES_DB=localmateai
POSTGRES_USER=localmate
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_PORT=5433

Jwt__SigningKey=replace-with-a-base64-encoded-key-of-at-least-32-bytes
ConnectionStrings__DefaultConnection=Host=localhost;Port=5433;Database=localmateai;Username=localmate;Password=replace-with-a-local-password
GoogleAuth__ClientId=replace-with-your-google-oauth-web-client-id.apps.googleusercontent.com

# OTP qua email (đăng ký + quên mật khẩu)
# Tạo Otp__HashKey (PowerShell): [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
Otp__HashKey=replace-with-a-base64-encoded-key-of-at-least-32-bytes
# Gmail chung của nhóm + App Password 16 ký tự (https://myaccount.google.com/apppasswords, cần bật Xác minh 2 bước)
Smtp__Username=replace-with-the-shared-gmail-address
Smtp__Password=replace-with-a-16-character-gmail-app-password

# PayOS credentials are server-only. Return/cancel URLs are navigation targets, not settlement proof.
PayOS__ClientId=
PayOS__ApiKey=
PayOS__ChecksumKey=
PayOS__ReturnUrl=
PayOS__CancelUrl=
