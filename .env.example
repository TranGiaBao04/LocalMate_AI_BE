# Local Docker database settings. Copy this file to .env and choose a private password.
POSTGRES_DB=localmateai
POSTGRES_USER=localmate
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_PORT=5433

Jwt__SigningKey=replace-with-a-base64-encoded-key-of-at-least-32-bytes
ConnectionStrings__DefaultConnection=Host=localhost;Port=5433;Database=localmateai;Username=localmate;Password=replace-with-a-local-password
GoogleAuth__ClientId=replace-with-your-google-oauth-web-client-id.apps.googleusercontent.com

# OTP qua email (đăng ký + quên mật khẩu)
# Tạo Otp__HashKey (PowerShell): [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
Otp__HashKey=replace-with-a-base64-encoded-key-of-at-least-32-bytes
# Gmail chung của nhóm + App Password 16 ký tự (https://myaccount.google.com/apppasswords, cần bật Xác minh 2 bước)
Smtp__Username=replace-with-the-shared-gmail-address
Smtp__Password=replace-with-a-16-character-gmail-app-password

# Embedding (tìm theo nghĩa, ghi chú khi tạo lịch): khoá Gemini API, lấy ở https://aistudio.google.com/apikey
# Bỏ trống = tính năng tắt, app chạy như chưa có embedding. Model và số chiều nằm ở mục Embedding của appsettings.json.
Embedding__ApiKey=

# LLM (AI viết lý do cho từng chặng, AI hiểu câu nhập): khoá Gemini API, dùng CHUNG giá trị với Embedding__ApiKey được.
# Bỏ trống = tính năng AI viết nội dung tắt, app vẫn tạo lịch bình thường. Model nằm ở mục Llm của appsettings.json.
Llm__ApiKey=

# PayOS credentials are server-only. Return/cancel URLs are navigation targets, not settlement proof.
PayOS__ClientId=
PayOS__ApiKey=
PayOS__ChecksumKey=
PayOS__ReturnUrl=
PayOS__CancelUrl=

# BE-81: tài khoản admin đầu tiên, tạo lúc API khởi động (mọi môi trường) nếu email chưa tồn tại. Bỏ trống = không tạo.
# Chỉ TẠO MỚI: đổi giá trị sau khi đã tạo KHÔNG đổi mật khẩu, không nâng quyền tài khoản có sẵn
# (quên mật khẩu thì dùng chức năng "quên mật khẩu"). Mật khẩu 8–128 ký tự, không commit mật khẩu thật.
# Email: nên là hộp thư THẬT do nhóm quản lý, bật Xác minh 2 bước. Nếu dùng chung Gmail gửi mail (Smtp__Username)
#   thì TẮT IMAP/POP trong cài đặt Gmail, vì App Password ở Smtp__Password đọc được hộp thư qua IMAP.
# Không dùng hộp thư thật thì dùng tên miền dành riêng, vd. admin@localmate.invalid (không ai nhận được mail,
#   nhưng quên mật khẩu sẽ không tự lấy lại được). KHÔNG dùng địa chỉ Gmail chưa ai tạo: người khác có thể
#   tạo đúng địa chỉ đó rồi chiếm admin qua "quên mật khẩu".
AdminSeed__Email=
AdminSeed__Password=
AdminSeed__FullName=
