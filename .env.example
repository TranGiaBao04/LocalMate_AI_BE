# Local Docker database settings. Copy this file to .env and choose a private password.
POSTGRES_DB=localmateai
POSTGRES_USER=localmate
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_PORT=5433

Jwt__SigningKey=replace-with-a-base64-encoded-key-of-at-least-32-bytes
ConnectionStrings__DefaultConnection=Host=localhost;Port=5433;Database=localmateai;Username=localmate;Password=replace-with-a-local-password
