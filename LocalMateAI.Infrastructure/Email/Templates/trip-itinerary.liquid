<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="color-scheme" content="light">
  <meta name="supported-color-schemes" content="light">
  <title>Lịch trình chuyến đi LocalMate AI</title>
</head>
<body style="margin:0;padding:0;background-color:#f1f5f9;">
  <div style="display:none;max-height:0;overflow:hidden;opacity:0;color:#f1f5f9;">Lịch trình {{ StopCount }} của bạn: {{ PlannedDate }}, {{ TimeRange }}.</div>
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#f1f5f9;">
    <tr>
      <td align="center" style="padding:32px 16px;">
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="max-width:560px;background-color:#ffffff;border:1px solid #e2e8f0;border-radius:16px;overflow:hidden;">
          <tr>
            <td style="height:6px;line-height:6px;font-size:0;background-color:#1d4ed8;background-image:linear-gradient(90deg,#1d4ed8,#4f46e5,#06b6d4);">&nbsp;</td>
          </tr>
          <tr>
            <td style="padding:24px 32px 20px;border-bottom:1px solid #f1f5f9;font-family:'Segoe UI',Roboto,-apple-system,'Helvetica Neue',Arial,sans-serif;">
              <div style="font-size:19px;font-weight:700;line-height:1.2;color:#0f2042;">LocalMate <span style="display:inline-block;padding:2px 6px;border-radius:4px;background-color:#2563eb;color:#ffffff;font-size:10px;font-weight:700;letter-spacing:0.5px;vertical-align:middle;">AI</span></div>
              <div style="font-size:12px;font-weight:500;line-height:1.5;color:#94a3b8;">Metro-friendly planner TP.HCM</div>
            </td>
          </tr>
          <tr>
            <td style="padding:28px 32px 4px;font-family:'Segoe UI',Roboto,-apple-system,'Helvetica Neue',Arial,sans-serif;">
              <h1 style="margin:0 0 8px;font-size:24px;line-height:1.3;font-weight:700;color:#0f2042;">Lịch trình đã được chốt</h1>
              <p style="margin:0;font-size:15px;line-height:1.6;color:#475569;">Chào {{ FullName }}, đây là lịch trình chuyến đi bạn vừa chốt. Chúc bạn có một chuyến đi vui vẻ!</p>
            </td>
          </tr>
          <tr>
            <td style="padding:20px 32px;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#0f2042;border-radius:16px;">
                <tr>
                  <td style="padding:20px 24px;font-family:'Segoe UI',Roboto,-apple-system,'Helvetica Neue',Arial,sans-serif;">
                    <div style="font-size:11px;font-weight:600;letter-spacing:2px;text-transform:uppercase;color:#cbd5e1;">Ngày đi</div>
                    <div style="margin:6px 0 4px;font-size:22px;font-weight:700;line-height:1.3;color:#ffffff;">{{ PlannedDate }}</div>
                    <div style="font-size:15px;font-weight:600;color:#fcd34d;">{{ TimeRange }}</div>
                  </td>
                </tr>
              </table>
            </td>
          </tr>
          <tr>
            <td style="padding:0 32px 20px;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="border:1px solid #e2e8f0;border-radius:12px;font-family:'Segoe UI',Roboto,-apple-system,'Helvetica Neue',Arial,sans-serif;font-size:14px;line-height:1.5;">
                <tr>
                  <td style="padding:10px 16px;color:#64748b;border-bottom:1px solid #f1f5f9;">Số chặng</td>
                  <td align="right" style="padding:10px 16px;color:#0f2042;font-weight:600;border-bottom:1px solid #f1f5f9;">{{ StopCount }}</td>
                </tr>
                <tr>
                  <td style="padding:10px 16px;color:#64748b;border-bottom:1px solid #f1f5f9;">Tổng thời gian</td>
                  <td align="right" style="padding:10px 16px;color:#0f2042;font-weight:600;border-bottom:1px solid #f1f5f9;">{{ TotalDuration }}</td>
                </tr>
                <tr>
                  <td style="padding:10px 16px;color:#64748b;border-bottom:1px solid #f1f5f9;">Chi phí dự kiến</td>
                  <td align="right" style="padding:10px 16px;color:#0f2042;font-weight:600;border-bottom:1px solid #f1f5f9;">{{ EstimatedBudget }}</td>
                </tr>
                <tr>
                  <td style="padding:10px 16px;color:#64748b;{% if StartStationName != "" %}border-bottom:1px solid #f1f5f9;{% endif %}">Phương tiện</td>
                  <td align="right" style="padding:10px 16px;color:#0f2042;font-weight:600;{% if StartStationName != "" %}border-bottom:1px solid #f1f5f9;{% endif %}">{{ TravelModeLabel }}</td>
                </tr>
                {% if StartStationName != "" %}
                <tr>
                  <td style="padding:10px 16px;color:#64748b;">Ga gần điểm xuất phát</td>
                  <td align="right" style="padding:10px 16px;color:#0f2042;font-weight:600;">{{ StartStationName }}</td>
                </tr>
                {% endif %}
              </table>
            </td>
          </tr>
          {% for stop in Stops %}
          <tr>
            <td style="padding:0 32px 12px;">
              {% if stop.TravelNote != "" %}
              <div style="padding:0 0 8px 4px;font-family:'Segoe UI',Roboto,-apple-system,'Helvetica Neue',Arial,sans-serif;font-size:12px;color:#94a3b8;">&#8595; {{ stop.TravelNote }}</div>
              {% endif %}
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="border:1px solid #e2e8f0;border-radius:12px;">
                <tr>
                  <td width="64" valign="top" style="padding:14px 0 14px 16px;font-family:'Segoe UI',Roboto,-apple-system,'Helvetica Neue',Arial,sans-serif;">
                    <div style="font-size:16px;font-weight:700;color:#1d4ed8;">{{ stop.Time }}</div>
                    <div style="font-size:11px;font-weight:600;color:#94a3b8;">Chặng {{ stop.OrderNumber }}</div>
                  </td>
                  <td valign="top" style="padding:14px 16px;font-family:'Segoe UI',Roboto,-apple-system,'Helvetica Neue',Arial,sans-serif;font-size:13px;line-height:1.5;color:#475569;">
                    <div style="font-size:15px;font-weight:700;color:#0f2042;">{{ stop.PlaceName }}</div>
                    <div style="margin-top:2px;"><span style="display:inline-block;padding:1px 8px;border-radius:999px;background-color:#eff6ff;color:#1d4ed8;font-size:11px;font-weight:600;">{{ stop.CategoryLabel }}</span></div>
                    {% if stop.Address != "" %}<div style="margin-top:6px;">{{ stop.Address }}</div>{% endif %}
                    <div style="margin-top:6px;color:#64748b;">{% if stop.StationName != "" %}Ga {{ stop.StationName }} · {% endif %}{{ stop.Duration }} · {{ stop.Cost }}</div>
                  </td>
                </tr>
              </table>
            </td>
          </tr>
          {% endfor %}
          <tr>
            <td style="padding:8px 32px 28px;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#f8fafc;border:1px solid #e2e8f0;border-radius:12px;">
                <tr>
                  <td style="padding:14px 16px;font-family:'Segoe UI',Roboto,-apple-system,'Helvetica Neue',Arial,sans-serif;font-size:13px;line-height:1.6;color:#475569;">
                    <strong style="color:#1e293b;">Lưu ý:</strong> Giờ và chi phí là ước tính, có thể thay đổi theo thực tế. Chi phí tính cho một người.
                  </td>
                </tr>
              </table>
            </td>
          </tr>
          <tr>
            <td align="center" style="padding:20px 32px;background-color:#f8fafc;border-top:1px solid #e2e8f0;font-family:'Segoe UI',Roboto,-apple-system,'Helvetica Neue',Arial,sans-serif;font-size:12px;line-height:1.6;color:#94a3b8;">
              Email tự động từ LocalMate AI, vui lòng không trả lời.<br>
              LocalMate AI · Đồng hành cùng Metro số 1 Bến Thành – Suối Tiên
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
