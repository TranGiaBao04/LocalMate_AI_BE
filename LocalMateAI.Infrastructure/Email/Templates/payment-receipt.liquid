<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="color-scheme" content="light">
  <meta name="supported-color-schemes" content="light">
  <title>Biên nhận thanh toán LocalMate AI</title>
</head>
<body style="margin:0;padding:0;background-color:#f1f5f9;">
  <div style="display:none;max-height:0;overflow:hidden;opacity:0;color:#f1f5f9;">Thanh toán {{ Amount }} cho gói {{ PlanName }} thành công. Gói có hiệu lực đến {{ ValidUntil }}.</div>
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#f1f5f9;">
    <tr>
      <td align="center" style="padding:32px 16px;">
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="max-width:560px;background-color:#ffffff;border:1px solid #e2e8f0;border-radius:16px;overflow:hidden;">
          <tr>
            <td style="height:6px;line-height:6px;font-size:0;background-color:#1d4ed8;background-image:linear-gradient(90deg,#1d4ed8,#4f46e5,#06b6d4);">&nbsp;</td>
          </tr>
          <tr>
            <td style="padding:24px 32px 20px;border-bottom:1px solid #f1f5f9;font-family:'Segoe UI',Roboto,-apple-system,'Helvetica Neue',Arial,sans-serif;">
              <div style="font-size:19px;font-weight:700;line-height:1.2;color:#0f2042;">LocalMate <span style="display:inline-block;padding:2px 6px;border-radius:4px;background-color:#2563eb;color:#ffffff;font-size:10px;font-weight:700;letter-spacing:0.5px;vertical-align:middle;">AI</span></div>
              <div style="font-size:12px;font-weight:500;line-height:1.5;color:#94a3b8;">Metro-friendly planner TP.HCM</div>
            </td>
          </tr>
          <tr>
            <td style="padding:28px 32px 4px;font-family:'Segoe UI',Roboto,-apple-system,'Helvetica Neue',Arial,sans-serif;">
              <h1 style="margin:0 0 8px;font-size:24px;line-height:1.3;font-weight:700;color:#0f2042;">Thanh toán thành công</h1>
              <p style="margin:0;font-size:15px;line-height:1.6;color:#475569;">Chào {{ FullName }}, cảm ơn bạn đã sử dụng LocalMate AI. Dưới đây là biên nhận cho giao dịch của bạn.</p>
            </td>
          </tr>
          <tr>
            <td style="padding:20px 32px;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#0f2042;background-image:linear-gradient(135deg,#0f2042,#1e293b);border-radius:16px;">
                <tr>
                  <td align="center" style="padding:24px 16px;font-family:'Segoe UI',Roboto,-apple-system,'Helvetica Neue',Arial,sans-serif;">
                    <div style="font-size:11px;font-weight:600;letter-spacing:2px;text-transform:uppercase;color:#cbd5e1;">Số tiền đã thanh toán</div>
                    <div style="margin:10px 0 6px;font-size:32px;font-weight:700;line-height:1.2;color:#ffffff;">{{ Amount }}</div>
                    <div style="font-size:13px;font-weight:500;color:#fcd34d;">Gói {{ PlanName }} · {{ TypeLabel }}</div>
                  </td>
                </tr>
              </table>
            </td>
          </tr>
          <tr>
            <td style="padding:0 32px 20px;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="border:1px solid #e2e8f0;border-radius:12px;font-family:'Segoe UI',Roboto,-apple-system,'Helvetica Neue',Arial,sans-serif;font-size:14px;line-height:1.5;">
                <tr>
                  <td style="padding:12px 16px;color:#64748b;border-bottom:1px solid #f1f5f9;">Mã đơn hàng</td>
                  <td align="right" style="padding:12px 16px;color:#0f2042;font-weight:600;border-bottom:1px solid #f1f5f9;font-family:Consolas,'Courier New',monospace;">{{ OrderCode }}</td>
                </tr>
                <tr>
                  <td style="padding:12px 16px;color:#64748b;border-bottom:1px solid #f1f5f9;">Thời gian thanh toán</td>
                  <td align="right" style="padding:12px 16px;color:#0f2042;font-weight:600;border-bottom:1px solid #f1f5f9;">{{ PaidAt }}</td>
                </tr>
                <tr>
                  <td style="padding:12px 16px;color:#64748b;border-bottom:1px solid #f1f5f9;">Phương thức</td>
                  <td align="right" style="padding:12px 16px;color:#0f2042;font-weight:600;border-bottom:1px solid #f1f5f9;">PayOS</td>
                </tr>
                <tr>
                  <td style="padding:12px 16px;color:#64748b;border-bottom:1px solid #f1f5f9;">Thời hạn cộng thêm</td>
                  <td align="right" style="padding:12px 16px;color:#0f2042;font-weight:600;border-bottom:1px solid #f1f5f9;">{{ AddedDays }}</td>
                </tr>
                <tr>
                  <td style="padding:12px 16px;color:#64748b;">Gói có hiệu lực đến</td>
                  <td align="right" style="padding:12px 16px;color:#1d4ed8;font-weight:700;">{{ ValidUntil }}</td>
                </tr>
              </table>
            </td>
          </tr>
          <tr>
            <td style="padding:0 32px 28px;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#f8fafc;border:1px solid #e2e8f0;border-radius:12px;">
                <tr>
                  <td style="padding:14px 16px;font-family:'Segoe UI',Roboto,-apple-system,'Helvetica Neue',Arial,sans-serif;font-size:13px;line-height:1.6;color:#475569;">
                    <strong style="color:#1e293b;">Lưu ý:</strong> Hãy giữ email này để đối chiếu khi cần. 
                  </td>
                </tr>
              </table>
            </td>
          </tr>
          <tr>
            <td align="center" style="padding:20px 32px;background-color:#f8fafc;border-top:1px solid #e2e8f0;font-family:'Segoe UI',Roboto,-apple-system,'Helvetica Neue',Arial,sans-serif;font-size:12px;line-height:1.6;color:#94a3b8;">
              Email tự động từ LocalMate AI, vui lòng không trả lời.<br>
              LocalMate AI · Đồng hành cùng Metro số 1 Bến Thành – Suối Tiên
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
